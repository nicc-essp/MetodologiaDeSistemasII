# Configuración pública para Docker Compose. No agregar credenciales.
VITE_API_BASE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:5173
# IDs de representantes habilitados en la base ficticia local, separados por comas.
AUTH_REPRESENTANTES_IDS=
# Puerto HTTP en ejecución directa. Compose conserva el puerto interno 3001.
# PORT=3001
# Mantener vacío salvo que se hayan verificado las direcciones del proxy.
TRUST_PROXY_CIDRS=

# PostgreSQL local. Las contraseñas se generan con node scripts/postgres.mjs preparar.
# Estos valores son públicos; las claves se montan como secretos desde archivos ignorados.
POSTGRES_TARGET=local
POSTGRES_HOST=127.0.0.1
POSTGRES_DB=docker_laws_dev
POSTGRES_PORT=5433
POSTGRES_SECRETS_DIR=./secrets/postgres
POSTGRES_TEST_PORT=0
POSTGRES_TEST_SECRETS_DIR=./secrets/postgres-test
